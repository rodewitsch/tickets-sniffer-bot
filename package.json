{
  "name": "tickets-telegram-bot",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "better-sqlite3": "^11.3.0",
    "drizzle-orm": "^0.45.2"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
