# Скопируйте в .env и заполните (.env gitignored; docker compose читает его
# автоматически). Не коммитьте реальные значения.

# Токен бота от @BotFather.
BOT_TOKEN=123456:ABC-DEF...

# Ваш домен, который указывает на droplet (Caddy поднимет HTTPS автоматически).
# Пример: bot.example.com. Для локального теста оставьте localhost.
TICKET_DOMAIN=bot.example.com

# Порты наружу (Caddy слушает 80/443; bot внутри — 8080). Менять не нужно.
PORT=8080

# Секрет для вызова /check по HTTP (не обязателен — крон идёт через cron-сервис).
CHECK_SECRET=

# Chat_id владельца: кому бот шлёт ежедневную статистику в 9:00 по Минску и кому
# доступна команда /stats. По умолчанию 637664405.
# STATS_CHAT_ID=637664405

# --- задаётся docker-compose автоматически (не менять без нужды) ---
# DB_PATH=/data/bot.db
# SERVE_STATIC=0 (Mini App на GitHub Pages)
# API_HOST=api.telegram.org

