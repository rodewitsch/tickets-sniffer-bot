# Скопируйте в .env и заполните (.env gitignored; docker compose читает его
# автоматически). Не коммитьте реальные значения.

# Токен бота от @BotFather.
BOT_TOKEN=123456:ABC-DEF...

# Ваш домен, который указывает на droplet (Caddy поднимет HTTPS автоматически).
# Пример: bot.example.com. Для локального теста оставьте localhost.
TICKET_DOMAIN=bot.example.com

# Порты наружу (Caddy слушает 80/443; bot внутри — 8080). Менять не нужно.
PORT=8080

# Секрет для вызова /check по HTTP (не обязателен — крон идёт через cron-сервис).
CHECK_SECRET=

# Секрет вебхука Telegram: бот сверяет заголовок X-Telegram-Bot-Api-Secret-Token
# и отвергает чужие POST на /webhook. Только A-Za-z0-9_- (1..256 символов).
#
# ВАЖНО ПО ПОРЯДКУ: задать значение И перевыпустить вебхук
# (`npm run set-webhook -- https://<домен>/webhook`) одним шагом. Если секрет
# задан, а вебхук не перевыпущен, Telegram не пришлёт заголовок и бот замолчит
# (все апдейты → 403), при этом /health будет зелёным. Пустое значение =
# проверка выключена (обратная совместимость).
# WEBHOOK_SECRET=

# Username бота без @ — из него собираются ссылки-диплинки «🔕 отписаться» в списке
# отслеживания (https://t.me/<BOT_USERNAME>?start=unsub_<id>).
# BOT_USERNAME=tickets_sniffer_bot

# Chat_id владельца: кому бот шлёт ежедневную статистику в 9:00 по Минску и кому
# доступна команда /stats. По умолчанию 637664405.
# STATS_CHAT_ID=637664405

# Подробность логов цикла проверки (lib/checker-log.js): off | summary | items | debug.
# CHECK_LOG_LEVEL=summary

# Раскладка времени цикла по фазам: одна строка `phase` на фазу плюс `phase.cycle`
# с непокрытым остатком. Нужна, чтобы решать «что оптимизировать» по цифрам.
# Включать временно — это отладка, а не постоянный отчёт.
# CHECK_LOG_PHASES=1

# --- задаётся docker-compose автоматически (не менять без нужды) ---
# DB_PATH=/data/bot.db
# SERVE_STATIC=0 (Mini App на GitHub Pages)
# API_HOST=api.telegram.org


# --- Парсинг через DigitalOcean Functions (необязательно) ---
# Сайты bycard.by / 24afisha.by блокируют IP Droplet. Если задать URL функций,
# поиск и детали уходят туда (другой egress), а БД/кэш/бюджеты остаются здесь.
# Пустое значение = парсить локально (поведение по умолчанию).
# Подробности: docs/do-functions-egress.md
# PARSER_URL_AFISHA=https://faas-fra1-afec6ce7.doserverless.co/api/v1/web/fn-1f346050-edc3-4cc5-8f78-f0c2b59d4bb1/parser/afisha
# PARSER_URL_TICKETPRO=https://faas-fra1-afec6ce7.doserverless.co/api/v1/web/fn-1f346050-edc3-4cc5-8f78-f0c2b59d4bb1/parser/ticketpro
# PARSER_URL_BEZKASSIRA=https://faas-fra1-afec6ce7.doserverless.co/api/v1/web/fn-1f346050-edc3-4cc5-8f78-f0c2b59d4bb1/parser/bezkassira
# FETCH_PROXY_URL=https://faas-fra1-afec6ce7.doserverless.co/api/v1/web/fn-1f346050-edc3-4cc5-8f78-f0c2b59d4bb1/netproxy/index
# PARSER_SECRET= (если на функциях включён webSecure)
